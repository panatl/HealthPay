# Example environment configuration file
# Copy this to .env and customize as needed

# API Settings
API_TITLE=HealthPay Payment Integrity Platform
API_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=false

# CORS Settings (comma-separated for lists)
CORS_ORIGINS=*

# Payment Integrity Thresholds
OVERPAYMENT_THRESHOLD=0.01
EXCESSIVE_UNITS_THRESHOLD=20
TIMELY_FILING_DAYS=90

# Fraud Detection Thresholds
HIGH_VOLUME_CLAIMS_THRESHOLD=50
HIGH_AVERAGE_CLAIM_AMOUNT=5000.0
SERVICE_CODE_CONCENTRATION_PCT=0.8
DOCTOR_SHOPPING_THRESHOLD=10
SAME_DAY_SERVICES_THRESHOLD=3

# Risk Score Weights
RISK_CRITICAL_WEIGHT=40
RISK_HIGH_WEIGHT=25
RISK_MEDIUM_WEIGHT=15
RISK_LOW_WEIGHT=5

# Logging
LOG_LEVEL=INFO
